{
  "name": "used-car-valuation",
  "version": "0.2.0",
  "private": true,
  "description": "macOS used-car purchase price estimator",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:seed": "node scripts/run-build-seed.js",
    "build:mac": "npm run build:seed && electron-builder --mac dir",
    "build:win": "npm run build:seed && electron-builder --win dir --x64"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "cn.carvalue.desktop",
    "productName": "二手车估价",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "data-store.js",
      "failure-export.js",
      "failure-ipc.js",
      "live-board.js",
      "voice-library.js",
      "voice-store.js",
      "resident-voice.js",
      "live-parser.js",
      "title-characters.js",
      "quote-account-maintenance.js",
      "quote-settings.js",
      "quote-account-pool.js",
      "quote-replay.js",
      "guazi-page-client.js",
      "guazi-service.js",
      "guazi-electron.js",
      "guazi-auth-preload.js",
      "vehicle-photos.js",
      "quote-learning.js",
      "catalog-additions.js",
      "catalog-additions.json",
      "douyin-bridge.js",
      "douyin-bridge-process.js",
      "douyin-bridge-service.mjs",
      "douyin-chat-avatars.mjs",
      "bridge-ws.mjs",
      "THIRD-PARTY-3D-PRINTER-LIVE-LICENSE",
      "portable-data.js",
      "latest-request.js",
      "embedded-login.js",
      "auth-preload.js",
      "preload.js",
      "price-decoder.js",
      "app/**/*"
    ],
    "asarUnpack": [
      "app/tts/*.py",
      "douyin-bridge-service.mjs",
      "douyin-chat-avatars.mjs",
      "bridge-ws.mjs"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "target": [
        "dir"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "dir"
      ]
    }
  },
  "dependencies": {
    "@paper-design/shaders": "0.0.82",
    "pinyin-pro": "3.29.5",
    "quill": "2.0.3"
  }
}
